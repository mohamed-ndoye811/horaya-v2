{
  "name": "horaya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d postgres mailpit",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @horaya/db generate",
    "db:migrate": "pnpm --filter @horaya/db migrate",
    "db:studio": "pnpm --filter @horaya/db studio",
    "db:auth-schema": "pnpm --filter @horaya/auth generate-schema"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
