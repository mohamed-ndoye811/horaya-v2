# Postgres local (pnpm db:up)
DATABASE_URL=postgres://horaya:horaya@localhost:5432/horaya

# Better Auth — générer le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# E-mails : Mailpit en local (http://localhost:8025). Vide = e-mails affichés dans la console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Horaya <bonjour@horaya.app>"

# Connexion Google (optionnelle) : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements en ligne (Stripe Connect). Sans ces clés, une passerelle de test simule
# Stripe (pages /paiement-test) : rien n'est débité.
# Clés du compte plateforme Horaya, en mode test : sk_test_… (Connect activé).
STRIPE_SECRET_KEY=
# Secret affiché par : stripe listen --forward-to localhost:3100/api/stripe/webhook \
#   --forward-connect-to localhost:3100/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
