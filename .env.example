# Poste de travail local (worktree permanent, voir « Postes de travail » dans CLAUDE.md) :
#   integration  horaya-v2/      port 3100  base horaya        suit develop, recette, vault
#   lot          ../horaya-lot   port 3101  base horaya_lot    lot en cours, seul à générer des migrations
#   fix          ../horaya-fix   port 3102  base horaya_fix    retouches courtes, pas de schéma
# `pnpm poste:init <lot|fix>` crée les postes lot et fix et réécrit ces quatre variables.
# Les postes lot et fix ont leurs propres cookies de session (horaya-lot, horaya-fix).
POSTE=integration
# Port de `pnpm dev`.
PORT=3100

# Postgres local (pnpm db:up) : une base par poste, dans le même conteneur.
DATABASE_URL=postgres://horaya:horaya@localhost:5432/horaya

# Better Auth — générer le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# E-mails : Mailpit en local (http://localhost:8025). Vide = e-mails affichés dans la console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Horaya <bonjour@horaya.app>"

# Connexion Google (optionnelle) : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://localhost:3100/api/auth/callback/google
# (ajouter 3101 et 3102 pour se connecter avec Google depuis les postes lot et fix)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements en ligne. Par défaut (sans clés Stripe), chaque organisateur colle son propre lien
# de paiement (Paramètres › Paiements, ou par événement) et l'équipe note les paiements reçus.
# Paiement intégré Stripe Connect : remplir les clés ci-dessous. PAYMENTS_TEST_GATEWAY=1 simule
# Stripe en local (pages /paiement-test) sans clés.
PAYMENTS_TEST_GATEWAY=
# Compte plateforme Horaya (Connect activé, comptes v2 « SaaS ») : de préférence un sandbox
# dédié (`stripe sandbox create`) et une clé restreinte rk_test_… avec les droits Accounts v2,
# Account Links, Checkout Sessions, Refunds, Balance et Payouts (à défaut, sk_test_…).
STRIPE_SECRET_KEY=
# Secret affiché par : stripe listen --forward-to localhost:3100/api/stripe/webhook \
#   --forward-connect-to localhost:3100/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
